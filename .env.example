# ==============================================================
#  Plantilla de variables de entorno de Supabase — mi-app
#  Copia este archivo como .env.local y rellena los valores:
#      cp .env.example .env.local
# ==============================================================

# URL de tu proyecto de Supabase (pública, se usa en el navegador)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública / anónima (publishable / anon key) — segura para el navegador
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio (service_role / secret key) — SOLO en el servidor
SUPABASE_SERVICE_ROLE_KEY=

# Clave del API de Anthropic (Claude) para el chat con IA — SOLO en el servidor
# Consíguela en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
